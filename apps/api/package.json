{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "db:setup": "tsx --env-file-if-exists=.env src/scripts/db-setup.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/db-migrate.ts",
